{
  "name": "aetheron-dashboard",
  "version": "1.0.0",
  "description": "Aetheron Admin Dashboard with Backend Server",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathPatterns=tests/unit",
    "test:integration": "jest --testPathPatterns=tests/integration",
    "test:e2e": "playwright test",
    "db:migrate": "npx drizzle-kit migrate",
    "db:seed": "node database/seed.js",
    "health": "node health-check.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,md}\"",
    "build": "npm run lint && npm run test:unit",
    "deploy:check": "./deploy.sh check",
    "deploy:railway": "./deploy.sh railway",
    "deploy:vercel": "./deploy.sh vercel",
    "deploy:docker": "./deploy.sh docker",
    "contracts:compile": "cd aetheron-contracts && npx hardhat compile",
    "contracts:test": "cd aetheron-contracts && npx hardhat test",
    "contracts:deploy:testnet": "cd aetheron-contracts && npx hardhat run scripts/deploy.js --network base_sepolia",
    "contracts:deploy:mainnet": "cd aetheron-contracts && npx hardhat run scripts/deploy.js --network base_mainnet",
    "contracts:verify": "cd aetheron-contracts && node scripts/verify.js",
    "bot": "node discord-bot.js",
    "deploy:liquidity": "node deploy-liquidity.js",
    "docker:up": "docker-compose -f docker-compose.prod.yml up -d",
    "docker:down": "docker-compose -f docker-compose.prod.yml down",
    "docker:logs": "docker-compose -f docker-compose.prod.yml logs -f",
    "backup:create": "node scripts/backup.js",
    "backup:restore": "node scripts/restore.js",
    "monitoring:setup": "node scripts/setup-monitoring.js",
    "cli": "node cli/aetheron.js",
    "backup": "node backup-recovery.js backup",
    "restore": "node backup-recovery.js restore",
    "security:scan": "node security-automation.js scan",
    "security:audit": "node security-automation.js audit",
    "db:generate": "drizzle-kit generate",
    "db:studio": "netlify dev:exec drizzle-kit studio"
  },
  "dependencies": {
    "@coinbase/cdp-sdk": "^1.41.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@netlify/neon": "^0.1.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "bcryptjs": "^2.4.3",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "cors": "^2.8.5",
    "discord.js": "^14.14.1",
    "drizzle-orm": "^0.45.2",
    "ethers": "^6.16.0",
    "express": "^4.21.2",
    "graphql-http": "^1.22.1",
    "graphql": "^16.8.1",
    "graphql-subscriptions": "^2.0.0",
    "inquirer": "^8.2.7",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.562.0",
    "ora": "^5.4.1",
    "openai": "^4.77.0",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "prom-client": "^15.1.3",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.6.0",
    "sequelize": "^6.37.8",
    "helmet": "^7.1.0",
    "sanitize-html": "^2.13.0",
    "socket.io-client": "^4.8.3",
    "speakeasy": "^2.0.0",
    "sqlite3": "^6.0.1",
    "stripe": "^14.25.0",
    "table": "^6.9.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/eslint-parser": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/testing-library__react": "^10.0.1",
    "babel-loader": "^10.0.0",
    "chai": "^4.5.0",
    "css-loader": "^7.1.2",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.8",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "hardhat": "^2.19.4",
    "html-webpack-plugin": "^5.6.5",
    "jest": "^30.5.2",
    "style-loader": "^4.0.0",
    "supertest": "^6.3.3",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.9.3",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1",
    "ws": "^8.19.0"
  },
  "keywords": [
    "aetheron",
    "blockchain",
    "admin",
    "dashboard",
    "crypto",
    "solana",
    "ethereum",
    "base",
    "polygon",
    "multichain"
  ],
  "author": "Aetheron Team",
  "license": "MIT",
  "overrides": {
    "hardhat": {
      "adm-zip": "^0.6.1",
      "undici": "^6.29.1"
    },
    "@nomicfoundation/hardhat-verify": {
      "undici": "^6.29.1"
    },
    "mocha": {
      "serialize-javascript": "^7.1.2"
    },
    "solc": {
      "tmp": "^0.2.7"
    },
    "zod": "^4.6.6"
  }
}
