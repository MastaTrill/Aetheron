{
  "name": "aetheron-contracts",
  "version": "1.0.0",
  "description": "Aetheron / Sentinel / L3 smart contracts — Base Mainnet",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:gas": "REPORT_GAS=true hardhat test",
    "coverage": "hardhat coverage",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network base_sepolia",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network base_mainnet",
    "post-deploy:mainnet": "hardhat run scripts/post-deploy.js --network base_mainnet",
    "node": "hardhat node",
    "clean": "hardhat clean"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.0",
    "dotenv": "^16.4.5"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.2"
  }
}